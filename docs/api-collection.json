            }
          }
        }
      ]
    },
    {
      "name": "e-POS Terminal",
      "item": [
        {
          "name": "Step 1: Scan Ration Card",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/distributor/epos/scan",
            "body": { "mode": "raw", "raw": "{\n  \"rationCardNo\": \"RC100200300\"\n}" }
          }
        },
        {
          "name": "Step 2: Biometric Fingerprint Check",
          "request": {
            "method": "POST",
