{
  "info": {
    "name": "Smart PDS REST API Collection",
    "description": "API collection for Smart Public Distribution System (Smart PDS) Major Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Distributor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/distributor/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Sharma\",\n  \"email\": \"distributor@example.com\",\n  \"password\": \"Distributor@123\",\n  \"phone\": \"9811223344\",\n  \"distributorGovtId\": \"DIS998877\",\n  \"aadhaarNumber\": \"123456789012\",\n  \"shopName\": \"Janata Fair Price Shop #42\",\n  \"shopAddress\": \"Shop No. 12, Main Market Road\",\n  \"areaWard\": \"Ward 12 - North Zone\"\n}"
            }
          }
        },
        {
          "name": "Register Consumer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/consumer/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"email\": \"consumer@example.com\",\n  \"password\": \"Consumer@123\",\n  \"phone\": \"9988776655\",\n  \"rationCardNo\": \"RC100200300\",\n  \"headOfHouseholdName\": \"Ramesh Kumar\",\n  \"address\": \"H.No. 45, Gali No. 3, North Block\",\n  \"familyMembers\": [\n    {\n      \"name\": \"Ramesh Kumar\",\n      \"relation\": \"Self (Head)\",\n      \"dateOfBirth\": \"1980-05-15\",\n      \"aadhaarNumber\": \"987654321098\"\n    }\n  ]\n}"
            }
          }
